{
  "name": "mq-story-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run db:generate && next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:public": "npm run db:generate && node scripts/public-stories/integration.mjs",
    "test:auth": "npm run db:generate && node scripts/auth/integration.mjs",
    "test:auth:hash": "node scripts/auth/hash-benchmark.mjs",
    "auth:env": "node scripts/auth/init-env.mjs",
    "dev:auth": "node scripts/auth/run-local.mjs dev",
    "start:auth": "node scripts/auth/run-local.mjs start",
    "check": "npm run lint && npm run db:validate && npm run typecheck && npm test && npm run build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:env": "node scripts/db/init-env.mjs",
    "db:up": "node scripts/db/compose.mjs up",
    "db:down": "node scripts/db/compose.mjs down",
    "db:stop": "node scripts/db/compose.mjs stop",
    "db:start": "node scripts/db/compose.mjs start",
    "db:recreate": "node scripts/db/compose.mjs recreate",
    "db:migrate": "node scripts/db/migrate.mjs deploy dev",
    "db:status": "node scripts/db/migrate.mjs status dev",
    "test:db": "npm run db:generate && node scripts/db/integration.mjs",
    "test:media": "npm run db:generate && node scripts/media/integration.mjs",
    "test:media:upload": "npm run db:generate && node scripts/media/upload-integration.mjs",
    "test:media:stories": "npm run db:generate && node scripts/media/story-integration.mjs",
    "test:media:lifecycle": "npm run db:generate && node scripts/media/lifecycle-integration.mjs",
    "media:maintain": "node scripts/media/maintain.mjs",
    "media:backup": "node scripts/media/backup-cli.mjs",
    "test:db:persistence": "npm run db:generate && node scripts/db/persistence.mjs",
    "test:auth:limiter": "node scripts/auth/rate-limit-regression.mjs --custom-only",
    "test:auth:transactions": "node scripts/auth/transaction-queue-regression.mjs",
    "test:auth:logs": "node scripts/auth/database-log-audit.mjs",
    "test:admin": "npm run db:generate && node scripts/admin/integration.mjs",
    "test:admin-drafts": "npm run db:generate && node scripts/admin-drafts/integration.mjs",
    "test:admin-editor": "npm run db:generate && node scripts/admin-editor/integration.mjs",
    "admin:maintain": "node scripts/admin/maintain.mjs",
    "test:admin-preview": "npm run db:generate && node scripts/admin-preview/integration.mjs",
    "test:publishing": "npm run db:generate && node scripts/publishing/integration.mjs",
    "test:likes": "npm run db:generate && node scripts/likes/integration.mjs",
    "test:comments": "npm run db:generate && node scripts/comments/integration.mjs",
    "test:production:db": "npm run db:generate && node scripts/production/database-tests.mjs && node scripts/production/database-cleanup-tests.mjs",
    "test:production:container": "node scripts/production/lab.mjs",
    "test:production:operations": "node scripts/production/lab.mjs --operations",
    "test:production:release": "node scripts/production/lab.mjs --release",
    "test:release": "node scripts/release/integration.mjs",
    "host:preflight": "node scripts/production/host-preflight.mjs",
    "test:production:rotation": "npm run db:generate && node scripts/production/rotation-tests.mjs",
    "test:auth:session-spike": "npm run db:generate && node scripts/auth/session-token-spike.mjs",
    "test:production:admin": "npm run db:generate && node scripts/production/admin-tests.mjs",
    "test:production:bootstrap": "node scripts/production/production-bootstrap-lab.mjs",
    "release:production": "node scripts/release/production-cli.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.12",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "1.64.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.72.0"
  }
}
