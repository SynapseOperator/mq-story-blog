root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown may use two trailing spaces for an intentional line break.
[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

# Let Go tooling and existing operations templates keep their own indentation.
[*.go]
indent_style = unset
indent_size = unset

[ops/**]
indent_style = unset
indent_size = unset
