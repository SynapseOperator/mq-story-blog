# Nonsecret template only. Copy outside Git; replace placeholders after approval.
# Console target: private Bucket, China (Hong Kong), Standard, ZRS.
# Restic 0.19.1 OSS profile; DNS bucket addressing is selected by the wrapper.
# Use the public endpoint from this non-Alibaba VPS. No custom CA or endpoint port.
MQ_BACKUP_BACKEND=s3
MQ_BACKUP_REPOSITORY=s3:https://oss-cn-hongkong.aliyuncs.com/REPLACE_BUCKET/production
MQ_BACKUP_S3_REGION=oss-cn-hongkong
MQ_BACKUP_REPOSITORY_ID=REPLACE_WITH_VERIFIED_64_HEX_REPOSITORY_ID
MQ_BACKUP_S3_CREDENTIALS_FILE=/run/secrets/backup_s3_credentials
MQ_BACKUP_PASSWORD_FILE=/run/secrets/backup_restic_password
# The existing deployment/backup configuration supplies database identities,
# reviewed image/source, workspace and receipt paths. No automatic S3 init.
# Do not paste AccessKeys or the Restic password here.
