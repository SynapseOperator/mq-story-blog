# No outbound notification by default. --send requires separate configuration,
# receiver validation and authorization; never add raw logs to the payload.
[Unit]
Description=MQ backup failure notification preview for %i

[Service]
Type=oneshot
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
WorkingDirectory=/srv/mq/current
# Preview still reports the current failure if the backup's env file was absent.
# Explicit --send remains fail-closed when its webhook secret is unavailable.
EnvironmentFile=-/etc/mq/backup/%i.env
ExecStart=/usr/bin/node /srv/mq/current/scripts/production/alert-webhook.mjs --backup-failure=%i
