# Nonsecret example only. Replace values for the explicitly approved deployment.
MQ_OPS_DEPLOYMENT_ID=REPLACE_WITH_CONFIRMED_DEPLOYMENT_UUID
MQ_OPS_PROJECT=mq-production
MQ_OPS_DISK_PATH=/var/lib/docker
MQ_OPS_ORIGIN=https://mq-story.xyz
MQ_OPS_BACKUP_RECEIPT=/srv/mq-production/REPLACE_WITH_CONFIRMED_DEPLOYMENT_UUID/backup-receipts/latest.json
# Production monitoring must match the real offsite receipt, not a local backup.
MQ_OPS_BACKUP_BACKEND=s3
MQ_OPS_BACKUP_REPOSITORY_ID=REPLACE_WITH_VERIFIED_64_HEX_REPOSITORY_ID
# Only used with an explicitly authorized --send; no secret values here.
MQ_ALERT_CHANNEL=feishu
MQ_ALERT_WEBHOOK_URL_FILE=/etc/mq/secrets/owner-feishu-webhook
MQ_ALERT_SIGNING_SECRET_FILE=/etc/mq/secrets/owner-feishu-signing
