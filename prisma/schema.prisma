generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

// Synthetic infrastructure probes, separate from all business records.
model DatabaseProbe {
  id        String   @id @default(uuid()) @db.Uuid
  value     String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("database_probe")
}

enum StoryKind {
  STAR
  CAMPFIRE
}

enum StoryState {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

model StarSlot {
  id       String @id @db.VarChar(64)
  sceneKey String @unique @map("scene_key") @db.VarChar(64)
  story    Story?

  @@map("star_slot")
}

// Native SQL additionally enforces the singleton campfire, legal lifecycle,
// immutable identity/published binding, and optimistic version increments.
model Story {
  id                  String          @id @default(uuid()) @db.Uuid
  slug                String          @unique @db.VarChar(120)
  kind                StoryKind
  state               StoryState      @default(DRAFT)
  slotId              String?         @unique @map("slot_id") @db.VarChar(64)
  draftRevisionId     String          @map("draft_revision_id") @db.Uuid
  publishedRevisionId String?         @map("published_revision_id") @db.Uuid
  version             Int             @default(0)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  slot                StarSlot?       @relation(fields: [slotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions           StoryRevision[] @relation("StoryRevisions")
  // Composite ownership FKs are DEFERRABLE INITIALLY DEFERRED in migration SQL:
  // create the story and its first immutable revision in the same transaction.
  draftRevision       StoryRevision   @relation("DraftRevision", fields: [id, draftRevisionId], references: [storyId, id], onDelete: Restrict, onUpdate: Restrict)
  publishedRevision   StoryRevision?  @relation("PublishedRevision", fields: [id, publishedRevisionId], references: [storyId, id], onDelete: Restrict, onUpdate: Restrict)
  likes               StoryLike[]
  comments            StoryComment[]

  @@map("story")
}

// Every save appends a revision. Native SQL rejects UPDATE and DELETE so an
// already-published revision cannot silently change with a later draft save.
model StoryRevision {
  id           String   @id @default(uuid()) @db.Uuid
  storyId      String   @map("story_id") @db.Uuid
  title        String   @db.VarChar(160)
  content      Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  story        Story    @relation("StoryRevisions", fields: [storyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  draftFor     Story[]  @relation("DraftRevision")
  publishedFor Story[]  @relation("PublishedRevision")
  assets       StoryRevisionAsset[]

  @@unique([storyId, id])
  @@map("story_revision")
}

enum MediaAssetState {
  PENDING
  READY
  FAILED
  DELETING
  DELETED
}

// Private storage identity and server-derived display/thumbnail metadata.
// Native SQL makes identity immutable and freezes metadata after PENDING.
model MediaAsset {
  id                  String               @id @default(uuid()) @db.Uuid
  storageKey          String               @unique @default(dbgenerated("gen_random_uuid()")) @map("storage_key") @db.Uuid
  state               MediaAssetState      @default(PENDING)
  displayMimeType     String?              @map("display_mime_type") @db.VarChar(32)
  displayWidth        Int?                 @map("display_width")
  displayHeight       Int?                 @map("display_height")
  displayBytes        Int?                 @map("display_bytes")
  displaySha256       String?              @map("display_sha256") @db.VarChar(64)
  thumbnailMimeType   String?              @map("thumbnail_mime_type") @db.VarChar(32)
  thumbnailWidth      Int?                 @map("thumbnail_width")
  thumbnailHeight     Int?                 @map("thumbnail_height")
  thumbnailBytes      Int?                 @map("thumbnail_bytes")
  thumbnailSha256     String?              @map("thumbnail_sha256") @db.VarChar(64)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  revisionAssets      StoryRevisionAsset[]

  // Composite FK key locks serialize historical references with deletion.
  @@unique([id, state])
  @@map("media_asset")
}

// Generated only by the revision INSERT trigger. Native SQL fixes requiredState
// to READY; a historical reference prevents READY -> DELETING at the FK itself.
model StoryRevisionAsset {
  revisionId    String          @map("revision_id") @db.Uuid
  assetId       String          @map("asset_id") @db.Uuid
  requiredState MediaAssetState @default(READY) @map("required_state")
  revision      StoryRevision   @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asset         MediaAsset      @relation(fields: [assetId, requiredState], references: [id, state], onDelete: Restrict, onUpdate: Restrict)

  @@id([revisionId, assetId])
  @@index([assetId, requiredState])
  @@map("story_revision_asset")
}

// Authentication compatibility fields are server-only. Admin authorization is
// a separate immutable identity binding, never a client-provided User role.
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  username String @unique
  displayUsername String?
  sessions Session[]
  accounts Account[]
  adminGrant AdminGrant?
  adminSecurityEvents AdminSecurityEvent[]
  storyLikes StoryLike[]
  storyComments StoryComment[] @relation("CommentAuthor")
  moderatedComments StoryComment[] @relation("CommentModerator")
}

enum CommentState {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

// Immutable submissions; only the signed moderation function changes state.
model StoryComment {
  id                String       @id @default(uuid()) @db.Uuid
  storyId           String       @map("story_id") @db.Uuid
  userId            String?      @map("user_id")
  body              String
  submissionKeyHash String       @unique @map("submission_key_hash") @db.VarChar(64)
  state             CommentState @default(PENDING)
  version           Int          @default(0)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  moderatedAt       DateTime?    @map("moderated_at") @db.Timestamptz(3)
  moderatedBy       String?      @map("moderated_by")
  approvedAt        DateTime?    @map("approved_at") @db.Timestamptz(3)
  story             Story        @relation(fields: [storyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user              User?        @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  moderator         User?        @relation("CommentModerator", fields: [moderatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([storyId, state, createdAt, id])
  @@index([state, createdAt, id])
  @@map("story_comment")
}

// One persistent like per account/story; withdrawal never deletes this record.
model StoryLike {
  userId    String   @map("user_id")
  storyId   String   @map("story_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, storyId])
  @@index([storyId])
  @@map("story_like")
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  // Keyed lookup only; the bearer is authenticated-encrypted outside the DB.
  tokenCiphertext String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@unique([providerId, accountId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model RateLimit {
  id String @id
  key String @unique
  count Int
  lastRequest BigInt
}

// Shared admission windows for HTTP authentication; HMAC identifiers only.
model AuthRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(3)
  @@index([expiresAt])
}

// Native CHECK id=1 plus the primary key enforce one persistent authorization
// identity, including after revocation. Triggers protect identity and lifecycle.
model AdminGrant {
  id                Int       @id @default(1)
  userId            String    @unique
  version           Int       @default(0)
  credentialVersion Int       @default(0)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

// Append-only trigger-generated operations. No token, password, email, story
// body or unbounded free text. Database identity is not a natural-person claim.
model AdminSecurityEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind          String   @db.VarChar(32)
  userId        String
  eventAt       DateTime @default(now()) @db.Timestamptz(3)
  databaseActor String
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, eventAt])
}
